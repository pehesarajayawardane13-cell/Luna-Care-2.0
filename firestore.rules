rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateId(id) {
      return id is string && id.size() == 10 && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isStringListBounded(val, maxItems) {
      return val is list && val.size() <= maxItems && (val.size() == 0 || val[0] is string);
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
             data.setupDone is bool &&
             data.pin is string && data.pin.matches('^[0-9]{4}$') &&
             data.themeMode in ['light', 'dark'] &&
             data.petalsEnabled is bool &&
             data.petalStyle in ['sakura', 'rose', 'lotus', 'blossom'] &&
             data.petalSize is int && data.petalSize >= 12 && data.petalSize <= 42 &&
             data.petalOpacityPct is int && data.petalOpacityPct >= 8 && data.petalOpacityPct <= 80 &&
             data.defaultCycleLength is int && data.defaultCycleLength >= 20 && data.defaultCycleLength <= 45 &&
             data.defaultPeriodDuration is int && data.defaultPeriodDuration >= 2 && data.defaultPeriodDuration <= 10 &&
             data.dailyWaterGoal is int && data.dailyWaterGoal >= 500 && data.dailyWaterGoal <= 5000 &&
             isStringListBounded(data.periodStarts, 240) &&
             (!('bfWhatsapp' in data) || (data.bfWhatsapp is string && data.bfWhatsapp.size() <= 40)) &&
             (!('bfEmail' in data) || (data.bfEmail is string && data.bfEmail.size() <= 120)) &&
             (!('careNotePeriod' in data) || (data.careNotePeriod is string && data.careNotePeriod.size() <= 500)) &&
             (!('careNotePms' in data) || (data.careNotePms is string && data.careNotePms.size() <= 500)) &&
             (!('careNoteOvulation' in data) || (data.careNoteOvulation is string && data.careNoteOvulation.size() <= 500)) &&
             (!('careNoteNormal' in data) || (data.careNoteNormal is string && data.careNoteNormal.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDailyLog(data, dateId) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.date is string && data.date == dateId && data.date.size() == 10 &&
             data.periodDay is bool &&
             data.flow is string && data.flow.size() <= 60 &&
             data.pain is int && data.pain >= 0 && data.pain <= 5 &&
             data.genSeverity is int && data.genSeverity >= 0 && data.genSeverity <= 5 &&
             data.waterMl is int && data.waterMl >= 0 && data.waterMl <= 10000 &&
             isStringListBounded(data.moods, 20) &&
             isStringListBounded(data.symptoms, 20) &&
             isStringListBounded(data.genSymptoms, 20) &&
             isStringListBounded(data.cravings, 20) &&
             data.note is string && data.note.size() <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'userName', 'setupDone', 'pin', 'themeMode',
                         'petalsEnabled', 'petalStyle', 'petalSize', 'petalOpacityPct',
                         'defaultCycleLength', 'defaultPeriodDuration', 'dailyWaterGoal',
                         'periodStarts', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'userName', 'setupDone', 'pin', 'themeMode',
                         'petalsEnabled', 'petalStyle', 'petalSize', 'petalOpacityPct',
                         'defaultCycleLength', 'defaultPeriodDuration', 'dailyWaterGoal',
                         'periodStarts', 'bfWhatsapp', 'bfEmail',
                         'careNotePeriod', 'careNotePms', 'careNoteOvulation', 'careNoteNormal',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'userName', 'setupDone', 'pin', 'themeMode',
                         'petalsEnabled', 'petalStyle', 'petalSize', 'petalOpacityPct',
                         'defaultCycleLength', 'defaultPeriodDuration', 'dailyWaterGoal',
                         'periodStarts', 'bfWhatsapp', 'bfEmail',
                         'careNotePeriod', 'careNotePms', 'careNoteOvulation', 'careNoteNormal',
                         'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /daily_logs/{dateId} {
        allow get: if isOwner(userId) && isValidDateId(dateId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidDateId(dateId) &&
                         incoming().keys().hasAll([
                           'userId', 'date', 'periodDay', 'flow', 'pain',
                           'genSeverity', 'waterMl', 'moods', 'symptoms',
                           'genSymptoms', 'cravings', 'note', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'date', 'periodDay', 'flow', 'pain',
                           'genSeverity', 'waterMl', 'moods', 'symptoms',
                           'genSymptoms', 'cravings', 'note', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidDailyLog(incoming(), dateId);

        allow update: if isOwner(userId) &&
                         isValidDateId(dateId) &&
                         isValidDailyLog(incoming(), dateId) &&
                         incoming().userId == existing().userId &&
                         incoming().date == existing().date &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'periodDay', 'flow', 'pain', 'genSeverity', 'waterMl',
                           'moods', 'symptoms', 'genSymptoms', 'cravings', 'note', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidDateId(dateId);
      }
    }
  }
}
